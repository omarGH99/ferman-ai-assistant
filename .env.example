# Copy to .env and adjust. None of these are required for local development.

# Signs login tokens. REQUIRED in production (the app refuses to start without
# it when DATABASE_URL is set). Generate with:
#   python -c "import secrets;print(secrets.token_hex(32))"
AUTH_SECRET=

# Postgres connection string. Unset = local SQLite file (app.db).
DATABASE_URL=

# Hugging Face model repos. Unset = small keyword fallback parser.
INTENT_REPO=OmarSY11/xlmr-intent-v2
SLOT_REPO=OmarSY11/xlmr-slot-v2

# Comma-separated origins allowed to call the API cross-origin.
# Unset = same-origin only in production, "*" in local dev.
ALLOWED_ORIGINS=

# Intent rejection thresholds.
INTENT_MIN_CONFIDENCE=0.35
INTENT_MIN_MARGIN=0.10

# Enables GET /feedback (send as X-Admin-Key header). Unset = endpoint closed.
FEEDBACK_KEY=
